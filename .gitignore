# ==========================================
# 1. SECURITY & SENSITIVE DATA (CRITICAL)
# ==========================================
# Never commit credentials, keys, or local configuration.
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crypto
secrets.json
credentials.json
sftp-config.json

# ==========================================
# 2. OPERATING SYSTEM CLUTTER
# ==========================================
# Folder metadata created by macOS and Windows.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# 3. APPLICATION RUNTIME & DEPENDENCIES
# ==========================================
# Installed packages (these should be managed via package managers).
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js
vendor/
.venv/
env/
venv/
ENV/
.env

# ==========================================
# 4. BUILD OUTPUTS & LOGS
# ==========================================
# Compiled code, logs, and build artifacts.
dist/
build/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.logs/

# ==========================================
# 5. IDE & EDITOR SETTINGS
# ==========================================
# Editor-specific configurations (optional, but recommended).
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp